{
  "$defs": {
    "ProvenanceLabel": {
      "enum": [
        "trusted_system_instruction",
        "authenticated_user_input",
        "internal_database",
        "external_web_content",
        "external_email",
        "third_party_document",
        "tool_output",
        "persistent_memory",
        "other_agent_message",
        "unverified"
      ],
      "title": "ProvenanceLabel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "field_path": {
      "maxLength": 500,
      "minLength": 1,
      "pattern": "^/",
      "title": "Field Path",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "key_id": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Key Id",
      "type": "string"
    },
    "labels": {
      "items": {
        "$ref": "#/$defs/ProvenanceLabel"
      },
      "minItems": 1,
      "title": "Labels",
      "type": "array",
      "uniqueItems": true
    },
    "parent_statement_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "title": "Parent Statement Ids",
      "type": "array"
    },
    "request_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_type": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Semantic Type",
      "type": "string"
    },
    "signature": {
      "title": "Signature",
      "type": "string"
    },
    "statement_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Statement Id",
      "type": "string"
    },
    "tenant_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    },
    "trace_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Trace Id",
      "type": "string"
    },
    "transformation": {
      "anyOf": [
        {
          "maxLength": 300,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transformation"
    },
    "value_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Value Digest",
      "type": "string"
    }
  },
  "required": [
    "statement_id",
    "request_id",
    "trace_id",
    "tenant_id",
    "field_path",
    "value_digest",
    "semantic_type",
    "labels",
    "issued_at",
    "expires_at",
    "key_id",
    "signature"
  ],
  "title": "FieldProvenanceStatement",
  "type": "object"
}
