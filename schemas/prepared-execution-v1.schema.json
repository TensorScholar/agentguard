{
  "$defs": {
    "PreparedExecutionStatus": {
      "enum": [
        "prepared",
        "committed",
        "cancelled",
        "expired"
      ],
      "title": "PreparedExecutionStatus",
      "type": "string"
    },
    "ReversibilityMode": {
      "enum": [
        "reversible",
        "compensatable",
        "irreversible"
      ],
      "title": "ReversibilityMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cancelled_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cancelled At"
    },
    "causal_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causal Digest"
    },
    "commit_not_before": {
      "format": "date-time",
      "title": "Commit Not Before",
      "type": "string"
    },
    "decision_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Decision Id",
      "type": "string"
    },
    "execution_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Execution Id",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "field_integrity_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Field Integrity Digest"
    },
    "intent_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Intent Digest",
      "type": "string"
    },
    "prepared_at": {
      "format": "date-time",
      "title": "Prepared At",
      "type": "string"
    },
    "prepared_binding_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Prepared Binding Digest",
      "type": "string"
    },
    "prepared_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Prepared Id",
      "type": "string"
    },
    "request_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "reversibility": {
      "$ref": "#/$defs/ReversibilityMode"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/PreparedExecutionStatus",
      "default": "prepared"
    },
    "trace_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "prepared_id",
    "execution_id",
    "decision_id",
    "request_id",
    "trace_id",
    "intent_digest",
    "prepared_binding_digest",
    "reversibility",
    "prepared_at",
    "commit_not_before",
    "expires_at"
  ],
  "title": "PreparedExecution",
  "type": "object"
}
