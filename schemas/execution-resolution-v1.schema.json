{
  "$defs": {
    "EvidenceTrustLevel": {
      "enum": [
        "decisionlock_signed",
        "provider_correlated",
        "provider_verified"
      ],
      "title": "EvidenceTrustLevel",
      "type": "string"
    },
    "ExecutionState": {
      "enum": [
        "reserved",
        "dispatching",
        "succeeded",
        "failed",
        "unknown"
      ],
      "title": "ExecutionState",
      "type": "string"
    },
    "ReconciliationStatus": {
      "enum": [
        "confirmed_succeeded",
        "confirmed_failed",
        "still_unknown",
        "unsupported",
        "conflict"
      ],
      "title": "ReconciliationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "error_code": {
      "anyOf": [
        {
          "maxLength": 300,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "evidence_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Evidence Digest",
      "type": "string"
    },
    "execution_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Execution Id",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "original_state": {
      "$ref": "#/$defs/ExecutionState"
    },
    "provider_operation_id_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Operation Id Digest"
    },
    "reconciled_at": {
      "format": "date-time",
      "title": "Reconciled At",
      "type": "string"
    },
    "resolution_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Resolution Id",
      "type": "string"
    },
    "source": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ReconciliationStatus"
    },
    "trust_level": {
      "$ref": "#/$defs/EvidenceTrustLevel"
    }
  },
  "required": [
    "resolution_id",
    "execution_id",
    "original_state",
    "status",
    "source",
    "evidence_digest",
    "trust_level",
    "observed_at",
    "reconciled_at"
  ],
  "title": "ExecutionResolution",
  "type": "object"
}
