{
  "$defs": {
    "FieldReleaseType": {
      "enum": [
        "human_endorsement",
        "system_attestation",
        "verified_transformation"
      ],
      "title": "FieldReleaseType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Action Digest",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "field_path": {
      "maxLength": 500,
      "minLength": 1,
      "pattern": "^/",
      "title": "Field Path",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "key_id": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Key Id",
      "type": "string"
    },
    "principal_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Principal Digest",
      "type": "string"
    },
    "provenance_statement_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Provenance Statement Digest",
      "type": "string"
    },
    "reason": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "release_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Release Id",
      "type": "string"
    },
    "release_type": {
      "$ref": "#/$defs/FieldReleaseType"
    },
    "request_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "resource_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resource Digest"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_type": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Semantic Type",
      "type": "string"
    },
    "signature": {
      "title": "Signature",
      "type": "string"
    },
    "subject_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subject Digest"
    },
    "tenant_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    },
    "trace_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Trace Id",
      "type": "string"
    },
    "value_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Value Digest",
      "type": "string"
    }
  },
  "required": [
    "release_id",
    "request_id",
    "trace_id",
    "tenant_id",
    "principal_digest",
    "action_digest",
    "field_path",
    "value_digest",
    "provenance_statement_digest",
    "semantic_type",
    "release_type",
    "reason",
    "issued_at",
    "expires_at",
    "key_id",
    "signature"
  ],
  "title": "FieldReleaseReceipt",
  "type": "object"
}
