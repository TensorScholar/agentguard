include README.md LICENSE CHANGELOG.md CITATION.cff MANIFEST.in Makefile setup.py pyproject.toml
include Dockerfile .dockerignore
include src/agentguard/py.typed
recursive-include src/agentguard/resources *.yaml *.json
recursive-include schemas *.json
recursive-include docs *.md
recursive-include examples *.md *.json *.jsonl *.yaml
recursive-include requirements *.txt
recursive-include scripts *.py
recursive-include benchmarks *.py *.json
recursive-include tests *.py *.json
include .github/dependabot.yml
include .github/CODE_OF_CONDUCT.md .github/CONTRIBUTING.md .github/SECURITY.md .github/SUPPORT.md
recursive-include .github/workflows *.yml
