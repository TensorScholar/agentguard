include README.md LICENSE CHANGELOG.md CITATION.cff MANIFEST.in Makefile setup.py pyproject.toml
include Dockerfile .dockerignore
include src/decisionlock/py.typed
recursive-include src/decisionlock/resources *.yaml *.json
# src/decisionlock/research is intentionally NOT distributed. It is the
# pre-registered authorization-lineage research record
# (RESEARCH_CLAIM: NOT_VALIDATED, thesis FALSIFIED_WITHIN_PROTOCOL; see
# docs/research/FREEZE_V2_RESULT_ADJUDICATION.md) and is excluded from the
# wheel and sdist by tool.setuptools.packages.find.exclude in pyproject.toml.
prune src/decisionlock/research
recursive-include schemas *.json
recursive-include docs *.md
recursive-include examples *.md *.json *.jsonl *.yaml *.py
recursive-include requirements *.txt
recursive-include scripts *.py
recursive-include benchmarks *.py *.json
recursive-include tests *.py *.json
include .github/dependabot.yml
include .github/CODE_OF_CONDUCT.md .github/CONTRIBUTING.md .github/SECURITY.md .github/SUPPORT.md
recursive-include .github/workflows *.yml
